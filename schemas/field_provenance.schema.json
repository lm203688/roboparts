{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "字段级 PROV (Field-Level Provenance)",
  "description": "字段级溯源 Schema，支持每个字段独立记录来源、可信度、证据链",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "field_provenance/v1.0",
      "description": "Schema 版本"
    },
    "entity_id": {
      "type": "string",
      "description": "实体唯一标识符 (rp_id)"
    },
    "field_name": {
      "type": "string",
      "description": "字段名称 (如: flange, pinout, electrical)"
    },
    "field_value": {
      "type": ["string", "number", "boolean", "array", "object"],
      "description": "字段原始值"
    },
    "prov": {
      "type": "object",
      "description": "字段级溯源信息",
      "properties": {
        "source": {
          "type": "string",
          "description": "数据来源类型 (datasheet/ingestion/user/legacy)"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "来源 URL 或文件路径"
        },
        "source_detail": {
          "type": "string",
          "description": "来源具体描述 (如: M8-4X-6P datasheet p.12)"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5,
          "description": "字段值可信度 (0-1)"
        },
        "evidence_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "已知证据缺口列表"
        },
        "evidence_links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "link_type": {
                "type": "string",
                "enum": ["external", "internal", "inferred"]
              },
              "target_entity": {
                "type": "string"
              },
              "relationship": {
                "type": "string"
              }
            }
          },
          "description": "相关证据链接"
        },
        "validation_status": {
          "type": "string",
          "enum": ["validated", "inferred_from_metadata", "not_validated"],
          "default": "not_validated"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "description": "最后更新时间"
        },
        "contributor": {
          "type": "string",
          "description": "贡献者标识"
        }
      },
      "required": ["source"]
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "字段注释"
    }
  },
  "required": ["entity_id", "field_name", "prov"]
}